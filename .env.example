# Copie para .env.local e preencha. .env.local nunca é versionado.
#
# Com DATA_SOURCE=mock o dashboard sobe com dados de exemplo e nenhuma outra
# variável é necessária — é o caminho para rodar o projeto logo após o clone.

DATA_SOURCE=mock

# --- Necessário apenas com DATA_SOURCE=sheets ---

# E-mail da service account do Google Cloud (termina em .iam.gserviceaccount.com).
# A planilha precisa estar compartilhada com este e-mail como Leitor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Chave privada da service account, entre aspas e com \n literais.
# Ex.: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# ID da planilha: o trecho entre /d/ e /edit na URL do Google Sheets.
FUNNEL_SHEET_ID=

# Intervalo da aba do funil em notação A1, incluindo a linha de cabeçalho.
# Uma linha por dia e canal.
FUNNEL_SHEET_RANGE=funil!A:F

# Intervalo da aba de metas, na mesma planilha.
# Uma linha por mês, canal e métrica.
GOALS_SHEET_RANGE=metas!A:D

# Intervalo da aba de cadastro de canais, na mesma planilha.
# Uma linha por canal, com o rótulo exibido e a ordem na tela.
CHANNELS_SHEET_RANGE=canais!A:C
